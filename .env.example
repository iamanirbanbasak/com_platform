# Copy to .env and fill in.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/club_platform?schema=public"
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
# Public URL of the site (used for auth callbacks and invite links)
BETTER_AUTH_URL="http://localhost:3000"

# Optional: Google sign-in (button hidden when empty)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend: required in production (emails are logged to the console when empty).
# EMAIL_FROM must use a domain verified in Resend; onboarding@resend.dev only
# delivers to the Resend account owner.
RESEND_API_KEY=""
EMAIL_FROM="Clubs <onboarding@resend.dev>"

# Optional: Vercel Blob (uploads saved to public/uploads when empty — dev only)
BLOB_READ_WRITE_TOKEN=""

# Seeded admin account
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="a-strong-password"
NEXT_PUBLIC_SITE_NAME="Clubhouse"

# IANA timezone used to enter and display event times
NEXT_PUBLIC_APP_TIMEZONE="UTC"
